<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.supermarket</groupId>
    <artifactId>week4-services</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>week4-services</name>
    <description>Self-Checkout System — Week 4: Service-Based Architecture (domain services, one shared database, gRPC)</description>

    <modules>
        <!-- libraries -->
        <module>shared-db</module>
        <module>contracts</module>
        <module>service-support</module>
        <!-- deployable units -->
        <module>catalog-service</module>
        <module>transaction-service</module>
        <module>inventory-service</module>
        <module>analytics-service</module>
        <module>gateway</module>
        <!-- executable proof of the module boundaries -->
        <module>architecture-tests</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <grpc.version>1.68.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <!-- Not managed by the Spring Boot parent BOM, so it must be pinned. -->
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <dependency>
                <groupId>com.supermarket</groupId>
                <artifactId>shared-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarket</groupId>
                <artifactId>contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.supermarket</groupId>
                <artifactId>service-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- The runnable fat jar is attached as "-exec", leaving the plain jar as the
                     module's main artifact so architecture-tests can analyse the service classes. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <classifier>exec</classifier>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
